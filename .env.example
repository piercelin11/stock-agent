# PostgreSQL connection string (Prisma reads this in prisma.config.ts and lib/prisma.ts)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/stock_agent"

# FinMind API key — optional; raises rate limit from 300 to 600 requests/hour.
# Used by scripts/backfill/* and scripts/pipeline/* FinMind fetches.
FINMIND_API_KEY=""
