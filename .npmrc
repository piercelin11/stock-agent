# Flat node_modules layout (like npm/yarn). Prisma 7's generated client lives in
# generated/prisma and imports @prisma/client + @prisma/adapter-pg + pg; the
# tsx-run scripts and the plist (absolute path to node_modules/tsx/dist/cli.mjs)
# expect those resolvable without pnpm's strict nesting. Keep hoisted.
node-linker=hoisted

# Fail fast if package.json and lockfile disagree (CI-safe default for a solo repo).
# Comment out if you frequently hand-edit package.json without re-running install.
# frozen-lockfile=true
